    {
      "parameters": {
        "jsCode": "const type = $json.fulfillment_type;\nconst address = ($json.delivery_address || '').toString().trim();\nconst lat = Number($json.delivery_lat);\nconst lng = Number($json.delivery_lng);\n\n// A real location: valid numbers, in range, and not the (0, 0) placeholder\nconst hasLocation = Number.isFinite(lat) && Number.isFinite(lng)\n  && !(lat === 0 && lng === 0)\n  && Math.abs(lat) <= 90 && Math.abs(lng) <= 180;\n\nif (type !== 'Delivery' && type !== 'Pickup') {\n  return [{ json: { valid: false, error: \"fulfillment_type must be 'Delivery' or 'Pickup'\" } }];\n}\n\nconst isDelivery = type === 'Delivery';\n\nif (isDelivery && !address && !hasLocation) {\n  return [{ json: { valid: false, error: 'Delivery address or location is required for delivery orders' } }];\n}\n\nreturn [{ json: {\n  valid: true,\n  order_id: $json.order_id,\n  fulfillment_type: type,\n  delivery_address: isDelivery ? (address || null) : null,\n  delivery_lat: isDelivery && hasLocation ? lat : null,\n  delivery_lng: isDelivery && hasLocation ? lng : null,\n  delivery_fee: isDelivery ? 100 : 0\n} }];"
      },
      "id": "814fbe5b-2fa6-4e2b-91a3-9d479a44f7e5",
