    {
      "parameters": {
        "jsCode": "const type = $json.fulfillment_type;\nconst address = ($json.delivery_address || '').toString().trim();\nconst lat = Number($json.delivery_lat);\nconst lng = Number($json.delivery_lng);\nconst msg = String($('When Executed by Another Workflow').first().json.customer_message || '');\n\nconst hasLocation = Number.isFinite(lat) && Number.isFinite(lng)\n  && !(lat === 0 && lng === 0)\n  && Math.abs(lat) <= 90 && Math.abs(lng) <= 180;\n\nif (type !== 'Delivery' && type !== 'Pickup') {\n  return [{ json: { valid: false, error: \"fulfillment_type must be 'Delivery' or 'Pickup'\" } }];\n}\n\nconst isDelivery = type === 'Delivery';\n\n// Pickup must be the customer's own choice (their latest message), never the assistant's guess\nif (!isDelivery && !/pick\\s*-?\\s*up|collect|takeaway|take\\s*away/i.test(msg)) {\n  return [{ json: { valid: false, error: 'The customer has not chosen Pickup. Do NOT choose it for them. Ask: Would you like Delivery (Rs. 100 fee) or Pickup? and wait for their reply.' } }];\n}\n\nif (isDelivery && !address && !hasLocation) {\n  return [{ json: { valid: false, error: 'Delivery address or location is required for delivery orders. Ask the customer to share their location pin or type their full address.' } }];\n}\n\nreturn [{ json: {\n  valid: true,\n  order_id: $json.order_id,\n  fulfillment_type: type,\n  delivery_address: isDelivery ? (address || null) : null,\n  delivery_lat: isDelivery && hasLocation ? lat : null,\n  delivery_lng: isDelivery && hasLocation ? lng : null,\n  delivery_fee: isDelivery ? 100 : 0\n} }];"
      },
