    {
      "parameters": {
        "jsCode": "const raw = String($('When Executed by Another Workflow').first().json.customer_id || '').trim();\nconst isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(raw);\nif (isUuid) return [{ json: { customer_id: raw } }];\nconst found = $('Find Customer').first().json || {};\nif (!found.id) throw new Error('Customer not found. Call Find or Create Customer first and use the customer_id it returns.');\nreturn [{ json: { customer_id: found.id } }];"
      },
      "id": "867e0d33-5bd8-47c5-874f-3296952235bd",
      "name": "Resolve Customer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "menu_items",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "is_archived",
              "condition": "eq",
              "keyValue": "false"
            }
          ]
        }
      },
      "id": "ae1f270d-1c19-4f1e-a582-8cdecf94e693",
      "name": "Get Live Menu Items",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const customer_id = $('Resolve Customer').first().json.customer_id;\nconst wanted = String($('When Executed by Another Workflow').first().json.first_item_name || '').trim().toLowerCase();\nconst menu = $input.all().map(i => i.json).filter(m => m.id && !m.is_archived);\nconst hit = wanted && menu.find(m => String(m.name).trim().toLowerCase() === wanted);\nif (!hit) {\n  return [{ json: { valid: false, error: 'No order was created because the customer has not chosen one specific menu item yet. Ask which item they want (if their word fits several items, list those options) and only call Create Order after they choose. Pass the exact menu item name in first_item_name.' } }];\n}\nreturn [{ json: { valid: true, customer_id } }];"
      },
      "id": "5e267843-73c2-4ba8-868b-8559e3002e1f",
