    {
      "parameters": {
        "jsCode": "const order = $('Get Orders').first().json;\nconst items = $('Get Order Items').all().map(i => i.json).filter(i => i.id);\nconst menu = $('Get Menu Items').all().map(m => m.json);\nconst lines = items.map(i => `${i.quantity}x ${menu.find(m => m.id === i.menu_item_id)?.name ?? 'Unknown'} — Rs. ${i.line_total}`);\nconst subtotal = items.reduce((s, i) => s + Number(i.line_total), 0);\nconst fee = Number(order.delivery_fee || 0);\nreturn [{ json: {\n  items_text: lines.join('\\n'),\n  fulfillment_type: order.fulfillment_type || 'NOT SET',\n  delivery_location_saved: !!(order.delivery_address || (Number(order.delivery_lat) && Number(order.delivery_lng))),\n  subtotal, delivery_fee: fee, total: subtotal + fee\n}}];"
      },
      "type": "n8n-nodes-base.code",
