    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.label);\nrows.sort((a, b) => Number(a.order_number) - Number(b.order_number));\nconst options = rows.map(r => r.label);\noptions.push('✔ Done — close this page');\nconst statuses = ['Preparing', 'Out for Delivery', 'Delivered', 'Cancelled'];\nconst formJson = JSON.stringify([\n  { fieldLabel: 'Select Order', fieldType: 'dropdown', requiredField: true, fieldOptions: { values: options.map(o => ({ option: o })) } },\n  { fieldLabel: 'Set Status To', fieldType: 'dropdown', requiredField: true, fieldOptions: { values: statuses.map(o => ({ option: o })) } }\n]);\nreturn [{ json: { options, count: rows.length, formJson } }];"
      },
      "id": "45a99db2-cff5-40ab-a860-5d806d6c0e66",
      "name": "Build Options",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        -304
      ]
    },
    {
      "parameters": {
        "defineForm": "json",
        "jsonOutput": "={{ $('Build Options').last().json.formJson }}",
        "options": {
          "formTitle": "Active Orders",
          "formDescription": "={{ $('Parse Selection').isExecuted ? '<div style=\"background:#e8f8ee;border:1px solid #9be0b4;padding:10px;border-radius:6px;margin-bottom:12px\">✅ <b>Order #' + $('Parse Selection').last().json['Order Number'] + '</b> is now <b>' + $('Parse Selection').last().json['New Status'] + '</b>. The customer was notified on WhatsApp.</div>' : '' }}{{ $('Build Options').last().json.count > 0 ? '<b>' + $('Build Options').last().json.count + ' active order(s).</b><br>1. Select an order (items and total are shown).<br>2. Choose its new status.<br>3. Tap the button. The customer gets a WhatsApp message.<br><br><small>Done updating? Select \"Done — close this page\".</small>' : '<b>No active orders right now.</b><br>Select \"Done — close this page\" to finish.' }}",
          "buttonLabel": "Update Status & Notify Customer"
        }
      },
      "id": "6d7b6455-bbae-4d07-81d1-d89d0606ab03",
      "name": "Pick Order",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        -368,
        -304
      ]
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst label = String(f['Select Order'] || '');\nconst m = label.match(/#(\\d+)/);\nreturn [{ json: { 'Order Number': m ? Number(m[1]) : null, 'New Status': f['Set Status To'], finished: label.startsWith('✔') || !m } }];"
      },
