{
  "name": "Sub - Generate Report",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const period = $json.period;\nconst tz = 'Asia/Karachi';\nconst now = DateTime.now().setZone(tz);\nlet start, end;\nif (period === 'daily')   { start = now.startOf('day');  end = now; }\nif (period === 'weekly')  { end = now.startOf('week');   start = end.minus({ weeks: 1 }); }\nif (period === 'monthly') { end = now.startOf('month');  start = end.minus({ months: 1 }); }\nconst labels = { daily: 'Daily', weekly: 'Weekly', monthly: 'Monthly' };\nconst range_label = period === 'daily'\n  ? start.toFormat('dd LLL yyyy')\n  : `${start.toFormat('dd LLL')} – ${end.minus({ days: 1 }).toFormat('dd LLL yyyy')}`;\nreturn [{ json: { period, period_label: labels[period], range_label,\n  start_date: start.toUTC().toISO(), end_date: end.toUTC().toISO() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        304
      ],
      "id": "1dd92a62-d868-429e-96f0-518274b42c32",
      "name": "Calculate Date Range"
    },
    {
      "parameters": {
        "jsCode": "const dedupe = a => { const s = new Set(); return a.filter(x => !s.has(x.id) && s.add(x.id)); };\nconst cfg = $('Calculate Date Range').first().json;\nconst all = dedupe($('Get Orders In Range').all().map(o => o.json)).filter(o => o.id);\nconst orders = all.filter(o => ['Confirmed','Preparing','Out for Delivery','Delivered'].includes(o.status));\nconst cancelled = all.filter(o => o.status === 'Cancelled').length;\nconst ids = new Set(orders.map(o => o.id));\nconst items = dedupe($('Get All Order Items').all().map(i => i.json)).filter(i => ids.has(i.order_id));\nconst menu = dedupe($('Get All Menu Items').all().map(m => m.json));\n\nconst count = orders.length;\nconst total = orders.reduce((s, o) => s + Number(o.total_amount), 0);\nconst fees = orders.reduce((s, o) => s + Number(o.delivery_fee || 0), 0);\nconst avg = count ? (total / count).toFixed(2) : '0.00';\nconst deliveries = orders.filter(o => o.fulfillment_type === 'Delivery').length;\nconst pickups = orders.filter(o => o.fulfillment_type === 'Pickup').length;\n\nconst t = {};\nitems.forEach(i => { const k = i.menu_item_id; t[k] = t[k] || { qty: 0, rev: 0 };\n  t[k].qty += Number(i.quantity); t[k].rev += Number(i.line_total); });\nconst top = Object.entries(t).sort((a, b) => b[1].qty - a[1].qty || b[1].rev - a[1].rev)\n  .slice(0, 5).map(([id, v]) => { const m = menu.find(x => x.id === id);\n    return `${m ? m.name : 'Unknown'} — ${v.qty} sold (Rs. ${v.rev})`; });\n\nconst html = `\n  <h2>📊 ${cfg.period_label} Report — MDA Restaurant</h2>\n  <p style=\"color:#888\">${cfg.range_label}</p>\n  <p><b>Orders:</b> ${count} (${deliveries} delivery, ${pickups} pickup) &nbsp; <b>Cancelled:</b> ${cancelled}</p>\n  <p><b>Total revenue:</b> Rs. ${total} &nbsp;(food Rs. ${total - fees} + delivery fees Rs. ${fees})</p>\n  <p><b>Avg order value:</b> Rs. ${avg}</p>\n  <p><b>Top items:</b><br>${top.join('<br>') || 'No sales in this period'}</p>`;\nreturn [{ json: { html, period_label: cfg.period_label } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        304
