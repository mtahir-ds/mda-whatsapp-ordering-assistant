    {
      "parameters": {
        "jsCode": "const order = $('Update Order').first().json;\nconst items = $('Get Order Items For Notification').all().map(i => i.json);\nconst menuItems = $('Get All Menu Items').all().map(m => m.json);\nconst customer = $('Get Customer Info').first().json;\n\n\nconst formBase = 'https://YOUR-INSTANCE.app.n8n.cloud/form/YOUR_FORM_ID';\nconst statusLink = `${formBase}?Order%20Number=${order.order_number}`;\n\n// Customer-typed text goes into an HTML email, so escape it\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\n// One line per menu item: quantities and prices of repeated rows are added together\nconst grouped = new Map();\nfor (const i of items) {\n  const g = grouped.get(i.menu_item_id) || { qty: 0, total: 0 };\n  g.qty += Number(i.quantity);\n  g.total += Number(i.line_total);\n  grouped.set(i.menu_item_id, g);\n}\nconst lines = [...grouped.entries()].map(([id, g]) => {\n  const menu = menuItems.find(m => m.id === id);\n  return `${g.qty}x ${esc(menu ? menu.name : 'Unknown')} — Rs. ${g.total}`;\n});\n\nconst isDelivery = order.fulfillment_type === 'Delivery';\nconst deliveryFee = Number(order.delivery_fee) || 0;\n\nlet fulfillmentHtml = `<p><b>Fulfillment:</b> ${esc(order.fulfillment_type || 'Not specified')}</p>`;\n\nif (isDelivery) {\n  const hasCoords = order.delivery_lat && order.delivery_lng;\n  const mapsLink = hasCoords\n    ? `https://www.google.com/maps?q=${order.delivery_lat},${order.delivery_lng}`\n    : null;\n  const addressText = order.delivery_address\n    ? esc(order.delivery_address)\n    : (hasCoords ? 'Shared location pin' : 'Not provided');\n\n  fulfillmentHtml += `\n    <p><b>Delivery address:</b> ${addressText}</p>\n    ${mapsLink ? `<p><a href=\"${mapsLink}\">📍 Open in Google Maps</a></p>` : ''}\n    <p><b>Delivery fee:</b> Rs. ${deliveryFee}</p>`;\n}\n\nconst html = `\n  <h2>🛎️ New Order Confirmed — #${order.order_number}</h2>\n  <p><b>Customer:</b> ${esc(customer.name)} (${esc(customer.wa_id)})</p>\n  ${fulfillmentHtml}\n  <p><b>Items:</b><br>${lines.join('<br>')}</p>\n  <p><b>Total:</b> Rs. ${order.total_amount}</p>\n  <p>\n    <a href=\"${statusLink}\"\n       style=\"background:#2e7d32;color:#fff;text-decoration:none;padding:12px 24px;border-radius:6px;display:inline-block;\">\n      Update Order Status\n    </a>\n  </p>\n  <p style=\"color:#888;font-size:12px;\">Order #${order.order_number}: Preparing → Out for Delivery → Delivered</p>\n`;\n\nreturn [{ json: { ...order, notification_html: html, items_text: lines.join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
