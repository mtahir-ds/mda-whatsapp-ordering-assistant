    {
      "parameters": {
        "jsCode": "const items = $input.all().filter(item => item.json && item.json.line_total !== undefined);\nconst itemsTotal = items.reduce((sum, item) => sum + Number(item.json.line_total), 0);\nconst order = $('Lookup Order For Status Check').first().json;\nconst deliveryFee = Number(order.delivery_fee) || 0;\nreturn [{ json: {\n  order_id: $('Trim order_id').first().json.order_id,\n  items_total: itemsTotal,\n  total_amount: itemsTotal + deliveryFee\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ],
      "id": "715ecac7-0c87-42ad-909e-3156ce2b7e06",
      "name": "Sum Total"
