      "id": "a7f5e5c5-cd59-4612-893c-ff7273932c74",
      "name": "Get All Menu Items",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Sanitize Inputs').first().json;\nconst words = String(input.customer_words || '');\nif (!words.trim()) {\n  return [{ json: { ...input, ambiguous: true,\n    error: 'customer_words is required. Call this tool again and put the customer\\'s exact words for this item (or the menu number they replied with) in customer_words.' } }];\n}\nconst menu = $input.all().map(i => i.json).filter(m => m.id && !m.is_archived);\n\n// --- Menu numbers: same order as the numbered text menu (deals first, then categories, items A-Z) ---\nconst numMatch = words.trim().match(/^#?\\s*(\\d{1,3})$/);\nif (numMatch) {\n  const ORDER = ['burgers', 'rolls & sandwiches', 'fries & snacks', 'karahi & handi', 'biryani & rice', 'bread & sides', 'drinks'];\n  const FALLBACK = 'More Items';\n  const deals = menu.filter(m => m.is_deal).sort((a, b) => (a.deal_number || 0) - (b.deal_number || 0));\n  const groups = new Map();\n  for (const m of menu.filter(m => !m.is_deal)) {\n    const k = String(m.category || '').trim() || FALLBACK;\n    if (!groups.has(k)) groups.set(k, []);\n    groups.get(k).push(m);\n  }\n  const rank = k => { const i = ORDER.indexOf(k.toLowerCase()); return i >= 0 ? i : k === FALLBACK ? 1000 : 500; };\n  const keys = [...groups.keys()].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));\n  const list = [...deals];\n  for (const k of keys) list.push(...groups.get(k).sort((a, b) => a.name.localeCompare(b.name)));\n  const n = Number(numMatch[1]);\n  const hit = list[n - 1];\n  if (!hit) {\n    return [{ json: { ...input, ambiguous: true,\n      error: `There is no item number ${n} on the menu (it has ${list.length} numbered entries). Ask the customer which item they mean.` } }];\n  }\n  return [{ json: { ...input, menu_item_name: hit.name, ambiguous: false } }];\n}\n\nconst stem = t => (t.length > 3 ? t.replace(/s$/, '') : t);\nconst tokens = s => String(s || '').toLowerCase().replace(/[^a-z0-9 ]/g, ' ')\n  .split(/\\s+/).filter(Boolean).map(stem);\nconst ignore = new Set(['a','an','the','one','two','three','please','want','order','like','and','i','of','piece','pc']);\nconst rawTokens = tokens(words);\n// keep a number when it directly follows the word deal (\"deal 2\"); other bare numbers are quantities\nconst cust = rawTokens.filter((t, i) => !ignore.has(t) && (!/^\\d+$/.test(t) || rawTokens[i - 1] === 'deal'));\n\nlet result = { ...input, ambiguous: false };\nif (cust.length) {\n  const matches = menu.filter(m => { const nt = tokens(m.name); return cust.every(t => nt.includes(t)); });\n  const exact = menu.find(m => tokens(m.name).join(' ') === cust.join(' '));\n  if (!exact && matches.length > 1) {\n    result = { ...input, ambiguous: true,\n      error: `Ambiguous item. The customer only said \"${words}\". Ask which one they want: ${matches.map(m => `${m.name} (Rs. ${m.price})`).join(', ')}. Do not choose for them.`,\n      customer_message: `Which ${words.trim()} would you like?\\n` + matches.map((m, i) => `${i + 1}) ${m.name} — Rs. ${Number(m.price)}`).join('\\n') };\n  } else {\n    // resolve to the real menu name (e.g. \"Family Feast\" -> \"Deal 1 - Family Feast\")\n    const hit = exact || (matches.length === 1 ? matches[0] : null);\n    if (hit) result = { ...input, menu_item_name: hit.name, ambiguous: false };\n  }\n}\nreturn [{ json: result }];"
      },
