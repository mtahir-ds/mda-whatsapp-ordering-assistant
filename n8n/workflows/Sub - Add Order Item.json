        672,
        288
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Sanitize Inputs').first().json;\nconst order = $('Get Order').first().json || {};\nconst newest = $('Get Newest Order').first().json || {};\nlet error = null;\nif (!order.id) {\n  error = 'Order not found. Call Create Order to start a new order, then add the item to it.';\n} else if (order.status !== 'Pending') {\n  error = 'This order is already closed. If the customer wants food, call Create Order for a brand-new order and add the item there.';\n} else if (newest.id && newest.id !== order.id) {\n  error = newest.status === 'Pending'\n    ? `This is an older unfinished order. The customer's current order is ${newest.id}. Use that order_id, or call Create Order if the customer is starting a fresh order.`\n    : 'This is an older unfinished order. Call Create Order for a brand-new order and add the item there.';\n}\nreturn [{ json: { ...input, order_ok: !error, order_error: error } }];"
      },
